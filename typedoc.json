{
  "$schema": "https://typedoc.org/schema.json",
  "name": "interopkit",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/core",
    "packages/tool-integration",
    "packages/learning-analytics",
    "packages/competency-frameworks",
    "packages/learning-records",
    "packages/selective-disclosure",
    "packages/achievement-credentials",
    "packages/course-launch"
  ],
  "readme": "README.md",
  "out": "docs/api",
  "plugin": ["typedoc-plugin-mermaid", "./docs/typedoc-seo.ts"],
  "mermaidVersion": "11.17.2",
  "treatWarningsAsErrors": true,
  "highlightLanguages": ["bash", "console", "html", "javascript", "json", "jsonc", "typescript", "yaml"]
}
