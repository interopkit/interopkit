{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!**/CHANGELOG.md",
      "!docs/api",
      "!**/test/fixtures",
      "!scripts/corpus.lock.json",
      "!scripts/schemas.lock.json",
      "!scripts/spec-examples.lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      },
      "correctness": {
        "noUndeclaredDependencies": "error",
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "ts": "js"
            }
          }
        }
      },
      "style": {
        "noDefaultExport": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "conventions": [
              {
                "selector": {
                  "kind": "typeParameter"
                },
                "match": "T(?:[A-Z][a-zA-Z]*)?",
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "CONSTANT_CASE"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noConsole": "error",
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**"],
      "linter": {
        "rules": {
          "security": {
            "noGlobalEval": "error"
          },
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noProcessEnv": "error",
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "XMLHttpRequest": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "WebSocket": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "window": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "document": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "process": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "setTimeout": "The libraries use no platform API: a host passes what they need, such as fetch, as an option.",
                  "setInterval": "The libraries use no platform API: a host passes what they need, such as fetch, as an option."
                }
              }
            }
          }
        }
      },
      "plugins": ["./biome/no-math-random.grit"]
    },
    {
      "includes": ["packages/*/src/**", "!packages/core/src/clock.ts"],
      "plugins": ["./biome/no-clock.grit"]
    },
    {
      "includes": [
        "packages/core/src/errors.ts",
        "packages/core/src/call-options.ts",
        "packages/core/src/random.ts",
        "packages/core/src/until-aborted.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*", "./*/**"],
                    "message": "errors.ts, call-options.ts, random.ts and until-aborted.ts depend on nothing."
                  },
                  {
                    "group": ["@interopkit/**"],
                    "message": "core is the lowest package of the family: it imports no other."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/formats.ts", "packages/core/src/json.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./*", "./*/**"],
                    "message": "formats.ts and json.ts depend on nothing of the package."
                  },
                  {
                    "group": ["@interopkit/**"],
                    "message": "core is the lowest package of the family: it imports no other."
