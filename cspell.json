  "words": [
    "assesskit",
    "Bahasa",
    "cpus",
    "Fariz",
    "gradebook",
    "imsglobal",
    "interopkit",
    "measurekit",
    "picklist",
    "SSSZ",
    "timeback",
    "Wakan"
  ]
}
