{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "files": [
    "packages/*/src/**",
    "packages/*/test/*.ts",
    "packages/*/README.md",
