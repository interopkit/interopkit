{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/core": {
      "entry": ["src/index.ts", "src/checks.ts", "src/http/index.ts", "src/oauth/index.ts"]
    },
    "packages/competency-frameworks": {
      "entry": ["src/index.ts", "src/client/index.ts", "src/graph/index.ts", "src/provider/index.ts"]
    },
    "packages/achievement-credentials": {
      "entry": [
        "src/index.ts",
        "src/baking/index.ts",
        "src/client/index.ts",
        "src/keys/index.ts",
        "src/jwt/index.ts",
        "src/data-integrity/index.ts",
        "src/status/index.ts",
        "src/refresh/index.ts",
        "src/verify/index.ts",
        "src/provider/index.ts"
      ]
    },
    "packages/learning-analytics": {
      "entry": ["src/index.ts", "src/endpoint/index.ts"]
    },
    "packages/learning-records": {
      "entry": [
        "src/index.ts",
        "src/attachments/index.ts",
        "src/client/index.ts",
        "src/signing/index.ts",
        "src/store/index.ts"
      ]
    },
    "packages/selective-disclosure": {
      "entry": ["src/index.ts"]
    },
    "packages/course-launch": {
      "entry": ["src/index.ts", "src/package/index.ts", "src/lms/index.ts", "src/au/index.ts", "test/memory-child.ts"]
    },
    "packages/tool-integration": {
      "entry": ["src/index.ts", "src/tool/index.ts", "src/platform/index.ts"]
    },
    "compat": {
      "entry": ["run.ts", "worker.ts"],
      "ignoreDependencies": ["workerd"]
    },
    "examples/course-launch": {
      "entry": ["unit.ts"]
    },
    ".": {
      "ignore": ["validation/catapult/*.js"],
      "ignoreDependencies": ["jscpd"]
    }
  }
}
