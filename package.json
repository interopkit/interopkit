{
  "name": "interopkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project '!*-corpus*' --project '!*-spec' --project '!*-browser*' --project '!*-bench' --project '!*-opensalt' --project '!*-sqllrs' --project '!*-validator' --project '!*-references' --project '!*-pylti1p3' --project '!*-moodle'",
    "test:references": "vitest run --project '*-references'",
    "test:corpus": "vitest run --project '*-corpus*'",
    "test:coverage": "vitest run --coverage --project '!*-corpus*' --project '!*-spec' --project '!*-browser*' --project '!*-bench' --project '!*-opensalt' --project '!*-sqllrs' --project '!*-validator' --project '!*-references' --project '!*-pylti1p3' --project '!*-moodle'",
    "test:browser": "vitest run --project '*-browser*'",
    "test:spec": "vitest run --project '*-spec'",
    "bench": "pnpm -r bench",
    "opensalt": "node validation/opensalt/run.ts",
    "adl-lrs": "node validation/adl-lrs/run.ts",
    "sql-lrs": "node validation/sql-lrs/run.ts",
    "w3c-suites": "node validation/w3c-suites/run.ts",
    "validator": "node validation/1edtech-validator/run.ts",
    "pylti1p3": "node validation/pylti1p3/run.ts",
    "moodle": "node validation/moodle/run.ts",
    "catapult-lms": "node validation/catapult/lms.ts",
    "catapult-content": "node validation/catapult/content.ts",
    "lint": "biome check . && cspell --no-progress",
    "check:standards": "node scripts/check-standards.ts",
    "check:rules": "node scripts/check-rules.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:audit": "pnpm audit --audit-level=high",
    "check:release": "node scripts/check-release.ts",
    "check:tarballs": "pnpm build && node scripts/check-tarballs.ts",
    "format": "biome check --write .",
    "knip": "knip",
    "docs:api": "pnpm build && typedoc",
    "check:packages": "pnpm -r check:packages",
    "corpus": "node scripts/corpus.ts fetch",
    "corpus:pin": "node scripts/corpus.ts pin",
    "schemas": "node scripts/schemas.ts fetch",
    "schemas:pin": "node scripts/schemas.ts pin",
    "spec-examples": "node scripts/spec-examples.ts fetch",
    "spec-examples:pin": "node scripts/spec-examples.ts pin",
    "caliper-tables": "node scripts/caliper-tables.ts fetch",
    "caliper-tables:pin": "node scripts/caliper-tables.ts pin",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "node scripts/prepare.ts",
    "compat": "node compat/check.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@cfworker/json-schema": "4.1.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "^10.4.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "libxml2-wasm": "0.7.2",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mermaid": "1.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "license": "Apache-2.0"
}
