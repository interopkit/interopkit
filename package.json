{
  "name": "interopkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "vitest run --project '!*-corpus*' --project '!*-spec' --project '!*-browser*'",
    "test:corpus": "vitest run --project '*-corpus*'",
    "test:coverage": "vitest run --coverage --project '!*-corpus*' --project '!*-spec' --project '!*-browser*'",
    "test:browser": "vitest run --project '*-browser*'",
    "test:spec": "vitest run --project '*-spec'",
    "lint": "biome check . && cspell --no-progress",
    "check:standards": "node scripts/check-standards.ts",
    "check:rules": "node scripts/check-rules.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:audit": "pnpm audit --audit-level=high",
    "format": "biome check --write .",
    "knip": "knip",
    "docs:api": "typedoc",
    "check:packages": "pnpm -r check:packages",
    "corpus": "node scripts/corpus.ts fetch",
    "corpus:pin": "node scripts/corpus.ts pin",
    "schemas": "node scripts/schemas.ts fetch",
    "schemas:pin": "node scripts/schemas.ts pin",
    "spec-examples": "node scripts/spec-examples.ts fetch",
    "spec-examples:pin": "node scripts/spec-examples.ts pin",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "lefthook install",
    "compat": "node compat/check.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "^10.4.0",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mermaid": "1.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0"
}
