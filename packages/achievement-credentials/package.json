{
  "name": "@interopkit/achievement-credentials",
  "version": "0.0.0",
  "description": "Open Badges 3.0 and CLR 2.0 credentials: the model of an achievement credential and of the API, readers that check them against the 1EdTech schemas, builders, identity hashes and comparison, the keys that verify them and their JSON Web Token form.",
  "keywords": [
    "interopkit",
    "achievement-credentials",
    "open-badges",
    "clr",
    "verifiable-credentials",
    "learning-standards"
  ],
  "author": "Fariz Wakan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/achievement-credentials"
  },
  "homepage": "https://github.com/interopkit/interopkit/tree/main/packages/achievement-credentials#readme",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./baking": {
      "types": "./dist/baking/index.d.ts",
      "default": "./dist/baking/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "default": "./dist/keys/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.ts",
      "default": "./dist/jwt/index.js"
    },
    "./data-integrity": {
      "types": "./dist/data-integrity/index.d.ts",
      "default": "./dist/data-integrity/index.js"
    },
    "./status": {
      "types": "./dist/status/index.d.ts",
      "default": "./dist/status/index.js"
    },
    "./refresh": {
      "types": "./dist/refresh/index.d.ts",
      "default": "./dist/refresh/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "oidc-provider": "9.12.2"
  },
  "dependencies": {
    "@interop/data-integrity-proof": "3.4.8",
    "@interop/did-method-key": "7.5.1",
    "@interop/did-web-resolver": "6.5.0",
    "@interop/ecdsa-multikey": "2.4.2",
    "@interop/ecdsa-signature": "2.0.10",
    "@interop/ed25519-signature": "7.2.5",
    "@interop/ed25519-verification-key": "8.2.2",
    "@interop/jsonld": "9.0.3",
    "@interop/jsonld-signatures": "11.9.0",
    "@interopkit/core": "workspace:^",
    "@interopkit/selective-disclosure": "workspace:^",
    "@noble/hashes": "2.4.0",
    "jose": "6.2.12",
    "saxes": "6.0.0",
    "valibot": "1.5.0"
  }
}
