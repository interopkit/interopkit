{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/baking/index.ts",
    "src/client/index.ts",
    "src/keys/index.ts",
    "src/jwt/index.ts",
    "src/data-integrity/index.ts",
    "src/status/index.ts",
    "src/refresh/index.ts",
    "src/verify/index.ts",
    "src/provider/index.ts"
  ],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/interopkit/interopkit/blob/{gitRevision}/packages/achievement-credentials/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "projectDocuments": ["../../docs/achievement-credentials/*.md"],
  "treatWarningsAsErrors": true
}
