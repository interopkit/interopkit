{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/graph/index.ts", "src/provider/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/interopkit/interopkit/blob/{gitRevision}/packages/competency-frameworks/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludePrivate": true,
  "projectDocuments": ["../../docs/competency-frameworks/*.md"],
  "treatWarningsAsErrors": true
}
