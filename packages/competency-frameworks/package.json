{
  "name": "@interopkit/competency-frameworks",
  "version": "0.0.0",
  "description": "CASE 1.1 and 1.0 for JavaScript and TypeScript: the model of a competency framework, readers checked against the published CASE JSON schemas, crosswalks, changes, and a client and a provider of the CASE REST API.",
  "keywords": [
    "case",
    "case-1.1",
    "competencies-and-academic-standards-exchange",
    "competency-framework",
    "competencies",
    "academic-standards",
    "learning-standards",
    "crosswalk",
    "typescript"
  ],
  "author": "Fariz Wakan (https://github.com/luthfanwakan)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/competency-frameworks"
  },
  "homepage": "https://interopkit.dev/_interopkit/competency-frameworks/",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "pnpm build && vitest bench --run --root ../.. --project 'competency-frameworks-bench*' --reporter verbose",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  },
  "dependencies": {
    "@interopkit/core": "workspace:^",
    "valibot": "1.5.0"
  }
}
