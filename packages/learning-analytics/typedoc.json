{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/endpoint/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "sourceLinkTemplate": "https://github.com/interopkit/interopkit/blob/{gitRevision}/packages/learning-analytics/{path}#L{line}",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "readme": "README.md",
  "excludeExternals": true,
  "externalPattern": ["**/packages/core/**"],
  "excludePrivate": true,
  "projectDocuments": ["../../docs/learning-analytics/*.md"],
  "treatWarningsAsErrors": true
}
