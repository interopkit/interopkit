{
  "name": "@interopkit/learning-analytics",
  "version": "0.0.0",
  "description": "Caliper Analytics 1.2 events with identifiers that stay the same when an event is reported again, and a sensor that sends them to an endpoint.",
  "keywords": [
    "interopkit",
    "learning-analytics",
    "caliper-analytics",
    "sensor",
    "events",
    "json-ld"
  ],
  "author": "Fariz Wakan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/learning-analytics"
  },
  "homepage": "https://github.com/interopkit/interopkit/tree/main/packages/learning-analytics#readme",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  },
  "dependencies": {
    "@interopkit/core": "workspace:^",
    "uuid": "14.0.3",
    "valibot": "1.5.0"
  }
}
