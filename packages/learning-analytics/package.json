{
  "name": "@interopkit/learning-analytics",
  "version": "0.0.0",
  "description": "Caliper Analytics 1.2 for JavaScript and TypeScript: the event and entity model, a sensor that sends events, and the endpoint that receives and checks them; reads Caliper 1.1.",
  "keywords": [
    "caliper",
    "caliper-analytics",
    "caliper-1.2",
    "learning-analytics",
    "learning-events",
    "sensor",
    "json-ld",
    "typescript"
  ],
  "author": "Fariz Wakan (https://github.com/luthfanwakan)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/learning-analytics"
  },
  "homepage": "https://interopkit.dev/_interopkit/learning-analytics/",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint/index.d.ts",
      "default": "./dist/endpoint/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "pnpm build && vitest bench --run --root ../.. --project 'learning-analytics-bench*' --reporter verbose",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  },
  "dependencies": {
    "@interopkit/core": "workspace:^",
    "uuid": "14.0.3",
    "valibot": "1.5.0"
  }
}
