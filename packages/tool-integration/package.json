{
  "name": "@interopkit/tool-integration",
  "version": "0.0.0",
  "description": "LTI 1.3 for JavaScript and TypeScript, in the tool and the platform role: launches, Deep Linking, Assignment and Grade Services, Names and Role Provisioning, Context Groups, Proctoring and Dynamic Registration.",
  "keywords": [
    "lti",
    "lti-1.3",
    "lti13",
    "lti-advantage",
    "learning-tools-interoperability",
    "lti-tool",
    "lti-platform",
    "deep-linking",
    "assignment-and-grade-services",
    "names-and-role-provisioning",
    "dynamic-registration",
    "lms",
    "openid-connect",
    "typescript"
  ],
  "author": "Fariz Wakan (https://github.com/luthfanwakan)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/tool-integration"
  },
  "homepage": "https://interopkit.wakan.dev/_interopkit/tool-integration/",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "bench": "pnpm build && vitest bench --run --root ../.. --project 'tool-integration-bench*' --reporter verbose",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@lti-tool/core": "1.3.3",
    "fast-check": "4.10.2",
    "lti-core": "0.5.0"
  },
  "dependencies": {
    "@interopkit/core": "workspace:^",
    "jose": "6.2.12",
    "valibot": "1.5.0"
  }
}
