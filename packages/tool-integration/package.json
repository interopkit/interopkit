{
  "name": "@interopkit/tool-integration",
  "version": "0.0.0",
  "description": "LTI 1.3 for learning platforms and tools: launch, access tokens and score publishing in both roles, and Deep Linking in the tool role, over plain requests and answers, with ports for storage, registrations, fetch and time. Not the whole of LTI Advantage.",
  "keywords": [
    "interopkit",
    "interoperability",
    "learning-platform",
    "learning-tools-interoperability",
    "deep-linking",
    "assignment-and-grade-services",
    "openid-connect",
    "jose"
  ],
  "author": "Fariz Wakan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/tool-integration"
  },
  "homepage": "https://github.com/interopkit/interopkit/tree/main/packages/tool-integration#readme",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "default": "./dist/tool/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  },
  "dependencies": {
    "@interopkit/core": "workspace:^",
    "jose": "6.2.12",
    "valibot": "1.5.0"
  }
}
