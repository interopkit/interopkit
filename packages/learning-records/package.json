{
  "name": "@interopkit/learning-records",
  "version": "0.0.0",
  "description": "xAPI 2.0 and 1.0.3 learning records: the model of a Statement, readers and validators for the rules of an LRS and of a Learning Record Provider, builders, signatures, a client of an LRS, the handler of its requests, and xAPI Profiles 1.0 with the validation of Statements against them.",
  "keywords": [
    "interopkit",
    "learning-records",
    "xapi",
    "experience-api",
    "learning-record-store",
    "statements",
    "xapi-profiles"
  ],
  "author": "Fariz Wakan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interopkit/interopkit.git",
    "directory": "packages/learning-records"
  },
  "homepage": "https://github.com/interopkit/interopkit/tree/main/packages/learning-records#readme",
  "bugs": "https://github.com/interopkit/interopkit/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments/index.d.ts",
      "default": "./dist/attachments/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "default": "./dist/profiles/index.js"
    },
    "./signing": {
      "types": "./dist/signing/index.d.ts",
      "default": "./dist/signing/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"for (const path of ['dist', 'tsconfig.build.tsbuildinfo']) fs.rmSync(path, { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "bench": "pnpm build && vitest bench --run --root ../.. --project 'learning-records-bench*' --reporter verbose",
    "check:packages": "pnpm build && publint --pack pnpm --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@humanwhocodes/momoa": "3.3.13",
    "@learninglocker/xapi-validation": "4.0.0",
    "fast-check": "4.10.2"
  },
  "dependencies": {
    "@interopkit/core": "workspace:^",
    "@noble/hashes": "2.4.0",
    "@remix-run/multipart-parser": "1.0.0",
    "jose": "6.2.12",
    "uuid": "14.0.3",
    "valibot": "1.5.0"
  }
}
